# Generated by ios/build-rust.sh — a ~200 MB LTO staticlib per slice.
FocrCore.xcframework/

# xcodebuild -archivePath / -exportPath output (xcarchive + export/)
/build/

# Generated by `xcodegen generate` from project.yml, which is the source.
FrankenOCR.xcodeproj/

# Xcode local state
xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/

# Simulator screenshots taken while verifying a change (`xcrun simctl io …
# screenshot`). Each is a couple of megabytes and none of them is source.
# Matched here rather than relying on a narrower root-level rule.
.*.png
